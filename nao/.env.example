# nao analytics agent environment variables.
# Copy to nao/.env and fill in. nao loads this file from the project directory
# (the `cd nao` in the Taskfile tasks ensures that), and resolves any
# ${{ env('VAR') }} references in nao_config.yaml against it.

# nao reads the DuckLake: catalog and data path come from nao_config.yaml
# (LAKE_DATA_PATH is exported by the Taskfile), so no database settings here.

# ── LLM provider ──────────────────────────────────────────────────────────────
# nao_config.yaml uses a local Ollama model, which needs no key. Ollama is
# expected on http://localhost:11434; override it here if it runs elsewhere:
# OLLAMA_BASE_URL=http://localhost:11434
#
# To switch to a hosted provider instead, change `llm:` in nao_config.yaml and
# set its key here, e.g.:
# ANTHROPIC_API_KEY=your_anthropic_api_key
# OPENROUTER_API_KEY=your_openrouter_api_key

# ── nao test (task nao:test) ──────────────────────────────────────────────────
# `nao test` calls the running chat server as a user. Create an organization API
# key in the chat UI (settings) and set it here, or use your login instead:
# NAO_API_KEY=nao_xxx
# NAO_USERNAME=you@example.com
# NAO_PASSWORD=...
